<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" width="32" height="32">
  <!-- 배경 -->
  <rect width="32" height="32" fill="#1e3c72"/>

  <!-- 간단한 비행기 아이콘 -->
  <g transform="translate(16, 16) rotate(-45) translate(-8, -8)">
    <!-- 동체 -->
    <rect x="7" y="4" width="2" height="10" fill="#ffffff"/>

    <!-- 주 날개 -->
    <rect x="3" y="8" width="10" height="2" fill="#ffffff"/>

    <!-- 꼬리 날개 -->
    <rect x="5" y="4" width="6" height="2" fill="#ffffff"/>
  </g>

  <!-- 항적 -->
  <g transform="translate(16, 16) rotate(-45)">
    <rect x="-3" y="3" width="1" height="5" fill="#5dade2" opacity="0.6"/>
    <rect x="-1" y="4" width="1" height="4" fill="#5dade2" opacity="0.4"/>
  </g>
</svg>